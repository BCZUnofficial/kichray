// KICH_WATER_V3: V2 rain/swamp + Clear Sky style soft-water response.
#include "common.h"
#include "kich_water_depth.h"
#include "kich_water_rain.h"

struct vf
{
#ifdef NEED_SOFT_WATER
    float4 water_clip : TEXCOORD7;
#endif
    float4 hpos        : POSITION;
    float2 tbase       : TEXCOORD0;
    float2 tnorm0      : TEXCOORD1;
    float2 tnorm1      : TEXCOORD2;
    half3  M1          : TEXCOORD3;
    half3  M2          : TEXCOORD4;
    half3  M3          : TEXCOORD5;
    float3 v2point     : TEXCOORD6;
    half4  c0          : COLOR0;
    float  fog         : FOG;
};

uniform sampler2D   s_nmap;
uniform samplerCUBE s_env0;
uniform samplerCUBE s_env1;

half4 main(vf I) : COLOR
{
    half4 base = tex2D(s_base, I.tbase);
    half3 n0 = tex2D(s_nmap, I.tnorm0).xyz;
    half3 n1 = tex2D(s_nmap, I.tnorm1).xyz;
    half3 normalTS = n0 + n1 - 1.0h;

    float3 world = I.v2point + eye_position.xyz;
    float patch = 0.65f * kich_water_noise(world.xz * 0.45f) +
                  0.35f * kich_water_noise(world.xz * 1.8f + 13.7f);

    half scum = saturate(base.a);
    half film = smoothstep(0.35f, 0.75f, patch) * scum * KICH_WATER_SWAMP;

    float cameraDistance = length(I.v2point);
    float normalStrength = lerp(KICH_WATER_NORMAL_STRENGTH, 0.28f,
                                smoothstep(20.0f, 100.0f, cameraDistance));
    normalTS = lerp(half3(0, 0, 1), normalTS, normalStrength);

    half3 N = normalize(mul(half3x3(I.M1, I.M2, I.M3), normalTS));

    // Keep V2 weather-driven rain rings.
    float rain = saturate(kich_water_weather.x);
    float2 ripple = kich_water_rain(world.xz, timers.x, rain) * (1.0f - film * 0.6f);
    ripple *= smoothstep(0.65f, 0.95f, abs(N.y));
    N = normalize(N + float3(ripple.x, 0.0f, ripple.y));

    half3 incident = normalize(I.v2point);
    half grazing = 1.0h - saturate(abs(dot(N, -incident)));
    half g2 = grazing * grazing;
    half fresnel = 0.02h + 0.98h * g2 * g2 * grazing;

    half3 reflected = reflect(incident, N);
    reflected.y = reflected.y * 2.0h - 1.0h;

    half3 environment = lerp(texCUBE(s_env0, reflected).rgb,
                             texCUBE(s_env1, reflected).rgb, L_ambient.w);
    half3 lighting = max(I.c0.rgb, 0.0h);

    half reflectionAmount = lerp(0.08h, 0.65h, fresnel) *
                            (1.0h - 0.65h * scum) *
                            (1.0h - film * 0.5h);

#ifdef NEED_SOFT_WATER
    float gap = kich_water_gap(I.water_clip);
#else
    // Non-soft fallback behaves like deep water and does not require scene depth.
    float gap = 20.0f;
#endif

    half murk = 1.0h - exp(-gap * KICH_WATER_MURK);
    half3 swampBase = lerp(base.rgb, base.rgb * half3(0.72h, 0.78h, 0.55h), film);
    swampBase *= lerp(half3(1, 1, 1), half3(0.66h, 0.72h, 0.52h),
                      murk * KICH_WATER_SWAMP);

    half3 color = lerp(swampBase * lighting * 1.30h,
                       environment * lighting * 1.30h,
                       reflectionAmount);

#ifdef NEED_SOFT_WATER
    // Clear Sky idea adapted to V2:
    // 1) grazing angles are naturally more opaque;
    // 2) the bank transition is depth driven, not a fixed alpha;
    // 3) exponential depth opacity fills deep water smoothly;
    // 4) water fades into the far fog through vertex fog alpha.
    half shore = kich_water_shore(gap);
    half angleAlpha = lerp(0.75h, 1.0h, fresnel);
    half alpha = min(angleAlpha, shore);
    alpha = max(alpha, (half)kich_water_depth_opacity(gap));

    // Rяска/scum can make water denser, but never resurrect alpha at zero depth.
    half materialBoost = saturate(scum * 0.30h + film * 0.45h);
    alpha += (1.0h - alpha) * materialBoost * shore;

    alpha *= I.c0.a * I.c0.a;
    return half4(color, saturate(alpha));
#else
    return half4(color, 1.0h);
#endif
}
