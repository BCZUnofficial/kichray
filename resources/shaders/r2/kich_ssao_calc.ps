// EX2 Test B: broad surface normal and virtual-height bias. Adapted from the supplied Clear Sky r2/ssao.ps:
// reflected Poisson taps and weighted occlusion/normalization formula.
// Changes: actual projection, world radius, finite math, sky/border guards,
// normal bias, half-resolution output, 6/12 runtime quality.
#include "common.h"
uniform float4 kich_ao_params; // radius, quality, projection scale x/y
uniform float3x4 kich_ao_view_to_world;

// Test B: estimate the broad surface plane instead of using the bump normal.
// Prefer the shorter valid one-sided difference to avoid crossing silhouettes.
float4 kich_ao_neighbor(float2 uv)
{
    float3 Q = tex2Dlod(s_position,float4(uv,0,0)).xyz;
    float valid = step(0.00001f,Q.z);
    valid *= step(0.0f,uv.x)*step(uv.x,1.0f)*step(0.0f,uv.y)*step(uv.y,1.0f);
    return float4(Q,valid);
}
float3 kich_ao_surface_normal(float2 tc, float3 P)
{
    float span = 0.20f;
    float2 offset = min(kich_ao_params.zw*span/max(P.z,0.1f),0.05f);
    float4 l = kich_ao_neighbor(tc-float2(offset.x,0));
    float4 r = kich_ao_neighbor(tc+float2(offset.x,0));
    float4 u = kich_ao_neighbor(tc-float2(0,offset.y));
    float4 d = kich_ao_neighbor(tc+float2(0,offset.y));
    float3 dl=P-l.xyz, dr=r.xyz-P, du=P-u.xyz, dd=d.xyz-P;
    float sl=dot(dl,dl)+(1-l.w)*1000000.0f;
    float sr=dot(dr,dr)+(1-r.w)*1000000.0f;
    float su=dot(du,du)+(1-u.w)*1000000.0f;
    float sd=dot(dd,dd)+(1-d.w)*1000000.0f;
    float3 dx = sl<sr ? dl : dr;
    float3 dy = su<sd ? du : dd;
    float3 normal = cross(dx,dy);
    float norm2 = dot(normal,normal);
    normal *= rsqrt(max(norm2,0.00000001f));
    normal *= dot(normal,-P)<0.0f ? -1.0f : 1.0f;
    // Missing/discontinuous plane: neutral AO rather than a false occluder.
    float valid = step(min(sl,sr),0.64f)*step(min(su,sd),0.64f)*step(0.00000001f,norm2);
    return normal*valid;
}

// Explicit taps avoid dynamically indexing a constant array on DX9.
float2 kich_ao_tap(float2 tc, float2 tap, float2 scale, float2 mirror,
                   float3 P, float3 N, float radius)
{
    tap -= 2.0f * dot(mirror,tap) * mirror;
    float2 uv = tc + tap*scale;
    // Explicit LOD is safe even inside the runtime quality branch (SM3).
    float3 Q = tex2Dlod(s_position,float4(uv,0,0)).xyz;
    float3 delta = Q-P;
    float distance = sqrt(max(dot(delta,delta),0.000001f));
    // Ignore small apparent height differences from virtual bump displacement
    // and half-float position quantization. Retain the angular bias as well.
    float bias = max(0.04f,min(P.z*0.001f,0.10f));
    float influence = saturate(((dot(delta,N)-bias)/distance-0.05f)/0.95f);
    float range = saturate(distance/radius);
    float valid = step(0.00001f,Q.z)*step(0.0011f,distance);
    valid *= step(0.0f,uv.x)*step(uv.x,1.0f)*step(0.0f,uv.y)*step(uv.y,1.0f);
    float w = valid*(influence+0.01f)/(range+0.1f);
    return float2(w*lerp(1.0f,range,influence),w);
}

float4 main(float2 tc : TEXCOORD0, float2 unused : TEXCOORD1, float2 pixel : VPOS) : COLOR
{
    float3 P = tex2D(s_position, tc).xyz;
    float3 N = kich_ao_surface_normal(tc,P);
    float radius = max(kich_ao_params.x, 0.1f);
    float2 scale = kich_ao_params.zw * radius / max(P.z, 0.1f);
    // Test D: decorrelate directions per half-resolution pixel.
    // No frame index: stationary-camera noise stays stationary.
    float noise = frac(52.9829189f * frac(dot(floor(pixel),float2(0.06711056f,0.00583715f))));
    float angle = noise * 6.28318530718f;
    float2 mirror = float2(cos(angle),sin(angle));
    float2 total = float2(0.1f,0.1f);
    if (P.z > 0.00001f)
    {
        total += kich_ao_tap(tc,float2(-0.326212,-0.405810)*0.68,scale,mirror,P,N,radius);
        total += kich_ao_tap(tc,float2(-0.695914,0.457137)*0.75,scale,mirror,P,N,radius);
        total += kich_ao_tap(tc,float2(0.962340,-0.194983)*0.63,scale,mirror,P,N,radius);
        total += kich_ao_tap(tc,float2(0.519456,0.767022)*0.73,scale,mirror,P,N,radius);
        total += kich_ao_tap(tc,float2(0.507431,0.064425)*0.65,scale,mirror,P,N,radius);
        total += kich_ao_tap(tc,float2(-0.321940,-0.932615)*0.70,scale,mirror,P,N,radius);
        if (kich_ao_params.y > 1.5f)
        {
            total += kich_ao_tap(tc,float2(-0.840144,-0.073580)*0.92,scale,mirror,P,N,radius);
            total += kich_ao_tap(tc,float2(-0.203345,0.620716)*0.95,scale,mirror,P,N,radius);
            total += kich_ao_tap(tc,float2(0.473434,-0.480026)*0.93,scale,mirror,P,N,radius);
            total += kich_ao_tap(tc,float2(0.185461,-0.893124)*0.98,scale,mirror,P,N,radius);
            total += kich_ao_tap(tc,float2(0.896420,0.412458)*0.90,scale,mirror,P,N,radius);
            total += kich_ao_tap(tc,float2(-0.791559,-0.597710),scale,mirror,P,N,radius);
        }
    }
    float ao = (saturate(total.x/total.y)+0.2f)/1.2f;
    // Avoid close-camera/HUD AO; fade very distant contributions.
    float fade = smoothstep(0.4f,0.9f,length(P)) * (1.0f-smoothstep(60.0f,100.0f,P.z));
    ao = lerp(1.0f,ao,fade*step(0.00001f,P.z));
    // R is unchanged AO; GBA carries the actual Test B normal for diagnostics.
    return float4(ao,N*0.5f+0.5f);
}
