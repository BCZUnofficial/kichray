; ============================================================
;  weather_default.ltx  —  L01_escape (Кордон) и общая погода
;  День 10:00–20:00 — светлее и теплее (kich_sun_halo).
;  Дождь днём (12:00, 16:00) — густая дымка (0.90).
;  Утро 05:00–07:15 — густая дымка (0.95), мягкий рассвет.
;  Закат 19:00–20:45 — плавный оранжевый → розовый → синий,
;  плотная дымка. Солнце уходит под горизонт к 20:45.
;  Ночь: солнце скрывается у горизонта, затем невидимо переключается
;  на луну; луна восходит с противоположного горизонта и идёт плавной дугой.
;  Ночь — на 25% темнее базовой; в зените луны — на 50% темнее.
;  Свет луны — холодный (голубоватый). Диск одного размера.
;  Ночной дождь усилен до rain_density = 0.50; дневной дождь затемняет свет на 50%.
; ============================================================

; --- Солнце с гало и бликами (для дня) ---
[kich_sun_halo]
flare_opacity            = 0.340, 0.260, 0.500, 0.420, 0.260, 0.260
flare_position           = 1.300, 1.000, 0.500, -0.300, -0.600, -1.000
flare_radius             = 0.080, 0.120, 0.040, 0.080, 0.120, 0.300
flare_textures           = fx\fx_flare1.tga, fx\fx_flare2.tga, fx\fx_flare2.tga, fx\fx_flare2.tga, fx\fx_flare3.tga, fx\fx_flare1.tga
flare_shader             = effects\flare
flares                   = on
gradient                 = on
gradient_opacity         = 0.75
gradient_radius          = 0.5000
gradient_texture         = fx\fx_gradient.tga
gradient_shader          = effects\flare
source                   = on
source_radius            = 0.150
source_texture           = fx\fx_sun.tga
source_shader            = effects\sun
source_ignore_color      = false
blend_time               = 1
blend_rise_time          = 1
blend_down_time          = 1

; --- Луна БЕЗ гало, один размер везде. Свет холодный ---
[kich_moon_halo]
flares                   = off
gradient                 = off
source                   = on
source_radius            = 0.04
source_texture           = fx\fx_moon.tga
source_shader            = effects\moon
source_ignore_color      = false
blend_time               = 1
blend_rise_time          = 1
blend_down_time          = 1


