; ============================================================
;  weather_default.ltx  —  L01_escape (Кордон) и общая погода
;  День 04:00–20:00 — светлее и теплее (kich_sun_halo).
;  Ночь 21:00–03:00 — луна с гало, холодный направленный
;  свет (тени), плавная кривая яркости. Пик темноты 02:00 —
;  луна ярче и контрастнее (kich_moon_halo_bright).
; ============================================================

; --- Солнце с гало и бликами (для дня) ---
[kich_sun_halo]
flare_opacity            = 0.340, 0.260, 0.500, 0.420, 0.260, 0.260
flare_position           = 1.300, 1.000, 0.500, -0.300, -0.600, -1.000
flare_radius             = 0.080, 0.120, 0.040, 0.080, 0.120, 0.300
flare_textures           = fx\fx_flare1.tga, fx\fx_flare2.tga, fx\fx_flare2.tga, fx\fx_flare2.tga, fx\fx_flare3.tga, fx\fx_flare1.tga
flare_shader             = effects\flare
flares                   = on
gradient                 = on
gradient_opacity         = 0.75
gradient_radius          = 0.5000
gradient_texture         = fx\fx_gradient.tga
gradient_shader          = effects\flare
source                   = on
source_radius            = 0.150
source_texture           = fx\fx_sun.tga
source_shader            = effects\sun
source_ignore_color      = false
blend_time               = 1
blend_rise_time          = 1
blend_down_time          = 1

; --- Луна с гало, холодный свет (тени), обычная яркость ---
[kich_moon_halo]
flares                   = off
gradient                 = on
gradient_opacity         = 0.8
gradient_radius          = 0.10
gradient_texture         = fx\fx_gradient_02.tga
gradient_shader          = effects\flare
source                   = on
source_radius            = 0.04
source_texture           = fx\fx_moon.tga
source_shader            = effects\moon
source_ignore_color      = false
blend_time               = 1
blend_rise_time          = 1
blend_down_time          = 1

; --- Луна с усиленным гало (для пика темноты 02:00) ---
[kich_moon_halo_bright]
flares                   = off
gradient                 = on
gradient_opacity         = 1.0
gradient_radius          = 0.15
gradient_texture         = fx\fx_gradient_02.tga
gradient_shader          = effects\flare
source                   = on
source_radius            = 0.06
source_texture           = fx\fx_moon.tga
source_shader            = effects\moon
source_ignore_color      = false
blend_time               = 1
blend_rise_time          = 1
blend_down_time          = 1

