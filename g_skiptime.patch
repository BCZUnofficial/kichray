 #include "level_debug.h"
@@ -54,6 +56,26 @@
 CPHWorld* ph_world = 0;
 float g_cl_lvInterp = 0;
 u32 lvInterpSteps = 0;
+
+extern int g_skiptime;
+extern bool g_bDisableAllInput;
+
+// Only the in-game calendar/environment are accelerated. Engine frame/physics time stays real-time.
+// This matches the factor used by the existing developer NumPad Multiply shortcut.
+static const float kSkipTimeFactor = 1000.f;
+static bool s_skipTimeActive = false;
+static float s_skipTimeOldGameFactor = 1.f;
+static float s_skipTimeOldEnvironmentFactor = 1.f;
+
+// Preserve the unaccelerated ALife factor in savegames while skipping time.
+// Keep the elapsed game-time itself: only the temporary multiplier is omitted.
+bool skiptime_get_save_factor(float& factor)
+{
+	if (!s_skipTimeActive)
+		return false;
+	factor = s_skipTimeOldGameFactor;
+	return true;
+}
 //////////////////////////////////////////////////////////////////////
 // Construction/Destruction
 //////////////////////////////////////////////////////////////////////
@@ -196,5 +218,16 @@ CLevel::~CLevel()
 {
 	//	g_pGameLevel		= NULL;
 	Msg("- Destroying level");
+
+	// Avoid retaining the accelerated factor when a level is unloaded during a key hold.
+	if (s_skipTimeActive)
+	{
+		if (game && Server && Server->game && GameID() == GAME_SINGLE)
+		{
+			Server->game->SetGameTimeFactor(s_skipTimeOldGameFactor);
+			Server->game->SetEnvironmentGameTimeFactor(s_skipTimeOldEnvironmentFactor);
+		}
+		s_skipTimeActive = false;
+	}
 
 	Engine.Event.Handler_Detach(eEntitySpawn, this);
@@ -485,6 +518,34 @@ void CLevel::OnFrame()
 	}
 
 	ProcessGameEvents();
+
+	// Physical NumPad 7 is sampled each frame, so releasing it while an in-game
+	// dialog/console is open cannot leave the time accelerator latched on.
+	// The separate console switch g_skiptime=1 keeps the accelerator enabled.
+	const bool skipReady = game && Server && Server->game && GameID() == GAME_SINGLE && OnServer() && !g_dedicated_server;
+	if (skipReady)
+	{
+		const bool menuOpen = MainMenu() && MainMenu()->IsActive();
+		const bool dialogOpen = pHUD && pHUD->GetUI() && pHUD->GetUI()->MainInputReceiver();
+		const bool held = !g_bDisableAllInput && pInput && !menuOpen && !dialogOpen &&
+			Console && !Console->bVisible && pInput->iGetAsyncKeyState(DIK_NUMPAD7);
+		const bool requested = !Device.Paused() && !menuOpen && !dialogOpen && (g_skiptime != 0 || held);
+
+		if (requested && !s_skipTimeActive)
+		{
+			s_skipTimeOldGameFactor = Server->game->GetGameTimeFactor();
+			s_skipTimeOldEnvironmentFactor = Server->game->GetEnvironmentGameTimeFactor();
+			Server->game->SetGameTimeFactor(kSkipTimeFactor);
+			Server->game->SetEnvironmentGameTimeFactor(kSkipTimeFactor);
+			s_skipTimeActive = true;
+		}
+		else if (!requested && s_skipTimeActive)
+		{
+			Server->game->SetGameTimeFactor(s_skipTimeOldGameFactor);
+			Server->game->SetEnvironmentGameTimeFactor(s_skipTimeOldEnvironmentFactor);
+			s_skipTimeActive = false;
+		}
+	}
 
 	if (m_bNeed_CrPr)
 		make_NetCorrectionPrediction();
